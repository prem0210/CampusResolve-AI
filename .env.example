# Database connection
DATABASE_URL=sqlite:///./campusresolve.db

# Required: generate a unique secret locally. Never commit a real value.
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Optional JWT settings
JWT_ALGORITHM=HS256
JWT_ISSUER=campusresolve-api
JWT_AUDIENCE=campusresolve-client
ACCESS_TOKEN_EXPIRE_MINUTES=60
